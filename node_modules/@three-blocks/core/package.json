{
  "name": "@three-blocks/core",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://three-blocks-196905988268.d.codeartifact.ap-northeast-1.amazonaws.com/npm/core/"
  },
  "version": "0.0.55",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^7.5.0",
    "esbuild-plugin-obfuscator": "^1.2.2",
    "javascript-obfuscator": "^4.1.0",
    "jsdoc": "^4.0.0",
    "live-server": "^1.2.1",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "bidi-js": "^1.0.3",
    "fflate": "^0.8.2",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.6",
    "troika-worker-utils": "^0.52.0",
    "webgl-sdf-generator": "^1.1.1"
  },
  "peerDependencies": {
    "three": ">=0.159.0"
  },
  "scripts": {
    "build": "tsup --config tsup.config.js && tsc",
    "build:obf": "TB_OBFUSCATE=1 tsup --config tsup.config.js",
    "dev": "tsup --config tsup.config.js --watch",
    "test": "vitest",
    "docs:extract": "node ../../utils/docs/extract.js",
    "docs:watch": "chokidar \"src/**/*.js\" -c \"pnpm build && pnpm docs:extract\"",
    "docs:install": "pnpm -C ../../docs install",
    "docs:dev": "pnpm build && pnpm docs:extract && concurrently -n data,astro -c blue,magenta \"pnpm docs:watch\" \"pnpm -C ../../docs dev\"",
    "docs:build": "pnpm build && pnpm docs:extract && pnpm -C ../../docs build"
  }
}